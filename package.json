{
  "name": "aus-food-labelling-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^24.13.1 || ^26.13.0"
  },
  "scripts": {
    "build": "corepack pnpm typecheck && corepack pnpm -r --if-present run build",
    "typecheck": "vue-tsc -b --pretty false",
    "lint": "eslint .",
    "test": "vitest run --passWithNoTests",
    "test:e2e": "playwright test --pass-with-no-tests",
    "validate:rules": "corepack pnpm --filter @aus-food/rules build && node scripts/validate-rules.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "eslint": "10.14.0",
    "eslint-plugin-vue": "10.12.0",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.1.0",
    "vue-eslint-parser": "10.4.1",
    "vue-tsc": "3.3.14"
  }
}
