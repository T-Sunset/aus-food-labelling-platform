{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    },
    "rootDir": "src",
    "resolveJsonModule": true,
    "outDir": "dist/types"
  },
  "references": [
    { "path": "../../packages/domain" },
    { "path": "../../packages/engine" },
    { "path": "../../packages/label" },
    { "path": "../../packages/storage" }
  ],
  "include": ["src/**/*.ts", "src/**/*.vue"]
}
